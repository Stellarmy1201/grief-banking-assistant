# Copy to .env and add your Gemini key. Never commit the real .env.
GEMINI_API_KEY=your-gemini-key-from-aistudio

# Admin panel (/admin) password and Flask session secret.
ADMIN_PASSWORD=change-me
SECRET_KEY=change-this-to-anything-random

# Database. These defaults match the docker-compose db service.
# For the Docker setup, leave them as they are.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=grief
DB_PASSWORD=griefpw
DB_NAME=grief_assistant
